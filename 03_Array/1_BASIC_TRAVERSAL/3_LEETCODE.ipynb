    "## __CHECK ARRAY IS SORTED___"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "3ce17e76",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True\n"
     ]
    }
   ],
   "source": [
    "##\n",
    "\n",
    "def IsSorted(nums):\n",
    "    \n",
    "    n =len(nums)\n",
    "\n",
    "    for i in range(n-1):\n",
    "\n",
    "        if nums[i] > nums[i+1]:\n",
    "\n",
    "            return False\n",
    "        \n",
    "    return True\n",
    "\n",
    "\n",
    "nums = [1,2,3,4,5]\n",
    "result = IsSorted(nums)\n",
    "print(result)"
   ]
