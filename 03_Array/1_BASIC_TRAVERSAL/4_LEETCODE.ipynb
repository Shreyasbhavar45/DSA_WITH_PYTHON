   "source": [
    "def LinearSearch(nums,target):\n",
    "\n",
    "    n = len(nums)\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        if nums[i] == target:\n",
    "\n",
    "            return i\n",
    "        \n",
    "    \n",
    "    return - 1\n",
    "\n",
    "\n",
    "nums = [1,2,3,4,5,6,7,83,9]\n",
    "target = 83\n",
    "\n",
    "result = LinearSearch(nums,target)\n",
    "\n",
    "print(result)"
   ]
  }
