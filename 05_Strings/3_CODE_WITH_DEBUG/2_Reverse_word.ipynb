   "source": [
    "## __151. Reverse Words in a String__"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "a3df1eb2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Football Playing are They\n"
     ]
    }
   ],
   "source": [
    "def reverseWord(s):\n",
    "\n",
    "    words = s.split()\n",
    "\n",
    "    w = words[::-1]\n",
    "\n",
    "    return \" \".join(w)\n",
    "    \n",
    "\n",
    "\n",
    "\n",
    "s = \"They are Playing Football\"\n",
    "result = reverseWord(s)\n",
    "print(result)"
   ]
  }
 ],
